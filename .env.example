# ─────────────────────────────────────────────────────────────
# Stxic environment variables (process.env reference)
# Copy to .env.local and fill in. NEVER commit .env.local.
# See docs/PROJECT_CONTEXT_MASTER.md for the full stack contract.
# ─────────────────────────────────────────────────────────────

# ── Firebase (DB + Auth) ─────────────────────────────────────
# Client-safe (exposed to browser) — prefix NEXT_PUBLIC_:
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── AI Cloud (Groq) — server-side only ───────────────────────
GROQ_API_KEY=
# Default: llama-3.1-8b-instant
GROQ_MODEL=llama-3.1-8b-instant

# ── AI Local (Ollama) — optional, server-side ────────────────
# Default base: http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
# Default: qwen2.5-coder:1.5b
OLLAMA_MODEL=qwen2.5-coder:1.5b

# ── Google Calendar (BADS-DE OAuth2) — server-side only ──────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ── No key required (by design) ──────────────────────────────
# FX:  frankfurter.app (ECB) — free, no key
# News: RSS only (Nitter / RSS.app / blogs) — no paid APIs
